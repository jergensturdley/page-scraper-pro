{
  "manifest_version": 3,
  "name": "Page Scraper Pro",
  "version": "1.0.0",
  "description": "Scrape images, videos, audio, URLs, and data from web pages with an intuitive UI",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Scraper Pro"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "downloads",
    "notifications",
    "sidePanel"
  ]
}
